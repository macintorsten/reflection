{
    "openapi": "3.1.0",
    "info": {
        "title": "Reflection API",
        "description": "CRUD operations for Sample entities with versioned endpoints",
        "license": {
            "name": "Unspecified",
            "url": "https://example.com"
        },
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Samples V2",
            "description": "Version 2 of Sample operations with aggregation support"
        },
        {
            "name": "Samples V1",
            "description": "Version 1 of Sample operations"
        }
    ],
    "paths": {
        "/api/v2/samples": {
            "get": {
                "tags": [
                    "Samples V2"
                ],
                "summary": "List samples (V2)",
                "description": "Returns all Samples with V2 response format",
                "operationId": "listSamples",
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/SampleResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Samples V2"
                ],
                "summary": "Create a sample (V2)",
                "description": "Creates a new Sample with priority support",
                "operationId": "createSample",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateSampleRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Sample created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SampleResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/samples": {
            "get": {
                "tags": [
                    "Samples V1"
                ],
                "summary": "List samples",
                "description": "Returns all Sample entities",
                "operationId": "listSamples_1",
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/SampleResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Samples V1"
                ],
                "summary": "Create a sample",
                "description": "Creates a new Sample entity",
                "operationId": "createSample_1",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateSampleRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Sample created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SampleResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v2/samples/{id}": {
            "get": {
                "tags": [
                    "Samples V2"
                ],
                "summary": "Get sample by ID (V2)",
                "description": "Returns a sample in V2 format",
                "operationId": "getSample",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Sample found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SampleResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Sample not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v2/samples/statistics": {
            "get": {
                "tags": [
                    "Samples V2"
                ],
                "summary": "Get sample statistics",
                "description": "Returns aggregate statistics for all samples (NEW in V2)",
                "operationId": "getStatistics",
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Statistics retrieved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StatisticsResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/samples/{id}": {
            "get": {
                "tags": [
                    "Samples V1"
                ],
                "summary": "Get sample by ID",
                "description": "Returns a sample by its ID",
                "operationId": "getSample_1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "200": {
                        "description": "Sample found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SampleResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Sample not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorResponse": {
                "type": "object",
                "description": "Error response",
                "properties": {
                    "message": {
                        "type": "string",
                        "description": "Error message",
                        "example": "Validation failed"
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "description": "HTTP status code",
                        "example": 400
                    },
                    "timestamp": {
                        "type": "string",
                        "description": "Timestamp of the error",
                        "example": "2025-12-20T15:00:00Z"
                    },
                    "fieldErrors": {
                        "type": "array",
                        "description": "Field-level validation errors",
                        "items": {
                            "$ref": "#/components/schemas/FieldError"
                        }
                    }
                }
            },
            "FieldError": {
                "type": "object",
                "description": "Field validation error",
                "properties": {
                    "field": {
                        "type": "string",
                        "description": "Field name",
                        "example": "text"
                    },
                    "message": {
                        "type": "string",
                        "description": "Error message",
                        "example": "size must be between 3 and 100"
                    }
                }
            },
            "CreateSampleRequest": {
                "type": "object",
                "description": "Request to create a new sample V2",
                "properties": {
                    "text": {
                        "type": "string",
                        "description": "Text value",
                        "example": "Hello World",
                        "maxLength": 100,
                        "minLength": 3
                    },
                    "number": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Number value",
                        "example": 42,
                        "maximum": 1000,
                        "minimum": 0
                    },
                    "status": {
                        "type": "string",
                        "description": "Status (ACTIVE or INACTIVE)",
                        "enum": [
                            "active",
                            "inactive"
                        ],
                        "example": "ACTIVE"
                    },
                    "priority": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Priority level (1-10)",
                        "example": 5,
                        "maximum": 10,
                        "minimum": 1
                    }
                },
                "required": [
                    "number",
                    "status",
                    "text"
                ]
            },
            "SampleResponse": {
                "type": "object",
                "description": "Sample response",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Sample ID",
                        "example": 1
                    },
                    "text": {
                        "type": "string",
                        "description": "Text value",
                        "example": "Hello World"
                    },
                    "number": {
                        "type": "integer",
                        "format": "int32",
                        "description": "Number value",
                        "example": 42
                    },
                    "status": {
                        "type": "string",
                        "description": "Status",
                        "enum": [
                            "active",
                            "inactive"
                        ],
                        "example": "active"
                    },
                    "extras": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "description": "Extra key-value pairs",
                        "example": {
                            "foo": "1"
                        }
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Creation timestamp"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Last update timestamp"
                    }
                }
            },
            "StatisticsResponse": {
                "type": "object",
                "description": "Aggregate statistics for all samples",
                "properties": {
                    "totalCount": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Total number of samples",
                        "example": 42
                    },
                    "averageNumber": {
                        "type": "number",
                        "format": "double",
                        "description": "Average number value across all samples",
                        "example": 123.45
                    },
                    "totalNumberSum": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Sum of all number values",
                        "example": 5185
                    },
                    "countByStatus": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "description": "Count by status",
                        "example": {
                            "ACTIVE": 30,
                            "INACTIVE": 12
                        }
                    },
                    "averagePriority": {
                        "type": "number",
                        "format": "double",
                        "description": "Average priority across all samples",
                        "example": 5.5
                    }
                }
            }
        }
    }
}
